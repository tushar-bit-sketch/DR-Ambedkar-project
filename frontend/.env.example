# ==============================================================================
# Frontend Environment Configuration (Vite + React)
# ==============================================================================

# API Base URL
# - In local development: http://127.0.0.1:8000/api/v1
# - In production: https://api.yourdomain.gov.in/api/v1 or /api/v1 (for same-origin reverse proxy)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Explicit Demo Mode Toggle
# When 'true', enables offline simulation fallbacks for turnkey demonstrations without a backend.
# In production, this MUST be 'false' (or omitted) to enforce strict radical curatorial honesty.
VITE_DEMO_MODE=false
