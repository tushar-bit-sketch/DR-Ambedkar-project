# ==============================================================================
# Frontend Environment Configuration (Vite)
# ==============================================================================

# Backend API Endpoint
# - For local development: http://127.0.0.1:8000/api/v1
# - For production on Vercel: set to your deployed backend URL (e.g. https://api.yourdomain.com/api/v1)
# - Leave empty to use relative /api/v1 if using Nginx or Vercel rewrites
VITE_API_URL=http://127.0.0.1:8000/api/v1
